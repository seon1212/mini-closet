<view class="page" wx:if="{{item}}"><view class="detail-image card"><image wx:if="{{item.processedImagePath || item.imagePath}}" src="{{item.processedImagePath || item.imagePath}}" mode="aspectFill"/><view wx:else class="image-placeholder">{{item.category}}</view></view><view class="row detail-heading"><view><text class="title-small">{{item.color}}{{item.category}}</text><text class="muted">穿过 {{item.wornCount}} 次</text></view><button class="ghost" bindtap="deleteItem">删除</button></view><view class="card detail-tags"><text class="tag" wx:for="{{item.style}}" wx:key="*this">{{item}}</text><text class="tag" wx:for="{{item.keywords}}" wx:key="*this">{{item}}</text></view><button class="primary" bindtap="useInWorkspace">加入搭配</button></view>
