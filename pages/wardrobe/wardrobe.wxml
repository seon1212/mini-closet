<view class="page">
  <view class="row"><view><view class="eyebrow">MY CLOSET</view><text class="title">我的衣橱</text></view><button class="add-button" bindtap="addClothing">＋</button></view>
  <view class="filters card"><scroll-view scroll-x class="filter-scroll"><view class="filter-item {{activeCategory === '全部' ? 'active' : ''}}" data-value="全部" bindtap="chooseCategory">全部</view><block wx:for="{{categories}}" wx:key="*this"><view class="filter-item {{activeCategory === item ? 'active' : ''}}" data-value="{{item}}" bindtap="chooseCategory">{{item}}</view></block></scroll-view><view class="filter-line"><picker mode="selector" range="{{colors}}" bindchange="chooseColor"><text>颜色：{{activeColor}}</text></picker><picker mode="selector" range="{{styles}}" bindchange="chooseStyle"><text>风格：{{activeStyle}}</text></picker></view></view>
  <view class="selection-bar" wx:if="{{selectedIds.length}}"><text>已选 {{selectedIds.length}} 件</text><button class="primary mini" bindtap="toWorkspace">加入搭配</button></view>
  <view class="grid" wx:if="{{filteredClothes.length}}"><block wx:for="{{filteredClothes}}" wx:key="id"><view class="clothing-card card {{item.isSelected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="toggleSelected"><view class="image-wrap"><image wx:if="{{item.processedImagePath || item.imagePath}}" src="{{item.processedImagePath || item.imagePath}}" mode="aspectFill"/><view wx:else class="image-placeholder">{{item.category}}</view><view class="check" wx:if="{{item.isSelected}}">✓</view></view><text class="clothing-name">{{item.color}}{{item.category}}</text><view><text class="tag" wx:for="{{item.style}}" wx:key="*this">{{item}}</text></view></view></block></view>
  <view class="empty" wx:else>还没有符合条件的衣服<br/><button class="ghost empty-button" bindtap="addClothing">添加衣服</button></view>
</view>
