<view class="page">
  <view class="eyebrow">OUTFIT STUDIO</view><text class="title">搭配工作台</text><text class="subtitle">先选你想穿的，再让灵感补齐。</text>
  <view class="selected-strip" wx:if="{{selectedClothes.length}}"><view class="row"><text class="section-title compact">已选单品</text><text class="muted">{{selectedClothes.length}} 件</text></view><scroll-view scroll-x class="selected-scroll"><block wx:for="{{selectedClothes}}" wx:key="id"><view class="selected-item"><view class="selected-image"><image wx:if="{{item.processedImagePath || item.imagePath}}" src="{{item.processedImagePath || item.imagePath}}" mode="aspectFill"/><text wx:else>{{item.category}}</text><view class="remove" data-id="{{item.id}}" bindtap="removeSelected">×</view></view><text>{{item.color}}{{item.category}}</text></view></block></scroll-view></view>
  <view class="preference card"><view class="section-title compact">告诉我今天的状态</view><view class="choice-label">心情</view><view class="choices"><block wx:for="{{moods}}" wx:key="*this"><view class="choice {{mood === item ? 'picked' : ''}}" data-value="{{item}}" bindtap="pickMood">{{item}}</view></block></view><view class="choice-label">风格</view><view class="choices"><block wx:for="{{styles}}" wx:key="*this"><view class="choice {{style === item ? 'picked' : ''}}" data-value="{{item}}" bindtap="pickStyle">{{item}}</view></block></view><view class="choice-label">场合</view><view class="choices"><block wx:for="{{occasions}}" wx:key="*this"><view class="choice {{occasion === item ? 'picked' : ''}}" data-value="{{item}}" bindtap="pickOccasion">{{item}}</view></block></view><input class="keyword-input" placeholder="还有什么想表达的？例如：想穿得精神一点" value="{{keywords}}" bindinput="inputKeywords"/></view>
  <view class="actions"><button class="ghost" bindtap="openWardrobe">从衣橱选衣服</button><button class="primary" bindtap="askAI" loading="{{loading}}">{{loading ? '正在搭配…' : 'AI 帮我搭配'}}</button></view>
  <view wx:if="{{result}}" class="result card"><view class="row"><text class="section-title compact">推荐组合</text><text class="muted">{{result.score}} 分</text></view><view class="result-clothes"><block wx:for="{{resultClothes}}" wx:key="id"><view class="result-item"><view class="result-image"><image wx:if="{{item.processedImagePath || item.imagePath}}" src="{{item.processedImagePath || item.imagePath}}" mode="aspectFill"/><text wx:else>{{item.category}}</text></view><text>{{item.color}}{{item.category}}</text></view></block></view><text class="explanation">{{result.explanation}}</text><view class="actions result-actions"><button class="secondary" bindtap="saveResult">保存搭配</button><button class="ghost" bindtap="openWardrobe">替换单品</button></view></view>
</view>
