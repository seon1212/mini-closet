.photo-picker { height:480rpx; margin-top:38rpx; overflow:hidden; }
.photo-picker image { width:100%; height:100%; }
.photo-empty { height:100%; display:flex; align-items:center; justify-content:center; flex-direction:column; color:#aaa39a; }
.plus { font-size:80rpx; font-weight:200; color:#b09d84; }
.form { margin-top:26rpx; padding:0 28rpx; }
.field { min-height:100rpx; display:flex; align-items:center; border-bottom:1rpx solid #eee9e0; color:#625d55; }
.field:last-child { border-bottom:0; }
.field > text { width:150rpx; }
.field input, .picker-value { flex:1; text-align:right; color:#20201e; }
.picker-value:after { content:' ›'; color:#aaa39a; }
.submit { margin-top:34rpx; }
